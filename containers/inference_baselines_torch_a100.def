Bootstrap: docker
From: nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

%files
    containers/locks/inference_baselines_torch_a100.txt /opt/inferencebench/constraints.txt

%post
    chmod 1777 /tmp
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR="/opt/tmp"
    export UV_CACHE_DIR="/opt/uv_cache"

    export UV_HTTP_TIMEOUT="600"
    export UV_LINK_MODE="copy"

    mkdir -p "${TMPDIR}" "${UV_CACHE_DIR}"

    apt-get update && apt-get install -y \
        python3.10 \
        python3-dev \
        python3-pip \
        python3-venv \
        git \
        wget \
        curl \
        iproute2 \
        net-tools \
        lsof \
        procps \
        ripgrep \
        ninja-build \
        pkg-config \
        cmake \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

    cat >/usr/local/bin/nvidia-smi <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
for candidate in \
  /usr/bin/nvidia-smi \
  /usr/local/nvidia/bin/nvidia-smi \
  /usr/lib/nvidia/current/nvidia-smi
do
  if [ -x "${candidate}" ]; then
    exec "${candidate}" "$@"
  fi
done
echo "nvidia-smi: not found; run the container with --nv." >&2
exit 127
EOF
    chmod +x /usr/local/bin/nvidia-smi

    ln -sf /usr/bin/python3.10 /usr/bin/python3
    ln -sf /usr/bin/python3.10 /usr/bin/python

    curl -LsSf https://astral.sh/uv/0.11.7/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt \
        --index-strategy unsafe-best-match --extra-index-url https://download.pytorch.org/whl/cu121 \
        torch==2.5.1+cu121

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt \
        aiohttp==3.13.5 \
        requests==2.33.1 \
        accelerate==1.13.0 \
        datasets==4.8.4 \
        sentencepiece==0.2.1 \
        numpy==2.2.6 \
        tokenizers==0.22.2 \
        transformers==5.5.4

    git clone --no-checkout https://github.com/rank-and-file/filelock_workarounds.git /opt/filelock_workarounds
    git -C /opt/filelock_workarounds checkout --detach e6e8ae16b3d8827e6089eb950dd45cfb93fb58bd

%environment
    export PATH="/root/.local/bin:$PATH"
    export NO_PROXY="localhost,127.0.0.1"
    export no_proxy="localhost,127.0.0.1"
    export SOFT_FILELOCK="${SOFT_FILELOCK:-1}"
    export PYTHONPATH="/opt/filelock_workarounds/soft_file_locks:$PYTHONPATH"

%runscript
    exec python3 "$@"
