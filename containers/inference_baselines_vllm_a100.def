Bootstrap: docker
From: nvidia/cuda:12.9.1-cudnn-devel-ubuntu22.04

%files
    containers/locks/inference_baselines_vllm_a100.txt /opt/inferencebench/constraints.txt
    containers/hpo-requirements.txt /opt/inferencebench/hpo-requirements.txt
    containers/hpo-constraints.txt /opt/inferencebench/hpo-constraints.txt

%post
    chmod 1777 /tmp
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR="/opt/tmp"
    export UV_CACHE_DIR="/opt/uv_cache"
    export UV_HTTP_TIMEOUT="600"
    export UV_LINK_MODE="copy"
    export PIP_CACHE_DIR="/opt/pip_cache"

    mkdir -p "${TMPDIR}" "${UV_CACHE_DIR}" "${PIP_CACHE_DIR}"

    apt-get update && apt-get install -y \
        python3.10 \
        python3-dev \
        python3-pip \
        python3-venv \
        git \
        wget \
        curl \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.10 /usr/bin/python3
    ln -sf /usr/bin/python3.10 /usr/bin/python

    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get install -y nodejs=22.22.2-1nodesource1

    curl -LsSf https://astral.sh/uv/0.11.7/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt \
        --index-strategy unsafe-best-match --extra-index-url https://download.pytorch.org/whl/cu128 \
        torch==2.8.0+cu128 \
        torchvision==0.23.0+cu128 \
        torchaudio==2.8.0+cu128

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt \
        --index-strategy unsafe-best-match --extra-index-url https://download.pytorch.org/whl/cu128 \
        xformers==0.0.32.post1

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt vllm==0.11.0 --torch-backend=auto

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt flashinfer-python==0.6.8.post1

    npm install -g \
        @anthropic-ai/claude-code@2.1.116 \
        @openai/codex@0.164.0 \
        @google/gemini-cli@0.38.2

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt ninja==1.13.0 packaging==26.1 wheel==0.37.1 setuptools==59.6.0

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt \
        accelerate==1.13.0 \
        boto3==1.40.61 \
        bitsandbytes==0.49.2 \
        datasets==4.8.4 \
        evaluate==0.4.6 \
        lm-eval==0.4.11 \
        openai==2.32.0 \
        pandas==2.3.3 \
        scikit-learn==1.7.2 \
        shortuuid==1.0.13 \
        tokenizers==0.22.2 \
        transformers==5.5.4 \
        trl==1.2.0 \
        peft==0.19.1 \
        inspect-ai==0.3.209 \
        tiktoken==0.12.0 \
        matplotlib==3.10.8 \
        certifi==2026.2.25

    export CUDA_HOME="/usr/local/cuda"
    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt flash_attn==2.8.3 --no-build-isolation

    uv pip install --system --no-cache --constraint /opt/inferencebench/constraints.txt \
        --constraint /opt/inferencebench/hpo-constraints.txt \
        -r /opt/inferencebench/hpo-requirements.txt

    git clone --no-checkout https://github.com/UKGovernmentBEIS/inspect_evals.git /opt/inspect_evals
    git -C /opt/inspect_evals checkout --detach 3dad175e20e9af21a5ecbabccefc004b8bbfe692

    git clone --no-checkout https://github.com/rank-and-file/filelock_workarounds.git /opt/filelock_workarounds
    git -C /opt/filelock_workarounds checkout --detach e6e8ae16b3d8827e6089eb950dd45cfb93fb58bd

%environment
    export PATH="/root/.local/bin:$PATH"
    export NO_PROXY="localhost,127.0.0.1"
    export no_proxy="localhost,127.0.0.1"
    export PYTHONPATH="/opt/filelock_workarounds/soft_file_locks:$PYTHONPATH"

%runscript
    exec python3 "$@"
