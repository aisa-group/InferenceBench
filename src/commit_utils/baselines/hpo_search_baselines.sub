executable = /bin/bash
arguments = src/baselines/run_precompute_all_baselines.sh $(base_model) $(Cluster) $(engine) $(seed_dev)
getenv = HOME,HF_HOME,HF_TOKEN,HF_HUB_DISABLE_XET,INFERENCE_BENCH_RESULTS_DIR,INFERENCE_BENCH_CONTAINERS_DIR,INFERENCE_BENCH_BASELINE_CONTAINER_VLLM_NAME,INFERENCE_BENCH_BASELINE_CONTAINER_SGLANG_NAME,INFERENCE_BENCH_VENV_VLLM_HOST,INFERENCE_BENCH_VENV_SGLANG_HOST,INFERENCE_BENCH_MAX_MODEL_LEN,INFERENCE_BENCH_INPUT_TOKEN_MARGIN,INFERENCE_BENCH_QUALITY_TAU,INFERENCE_BENCH_QUALITY_SEED,INFERENCE_BENCH_QUALITY_MMLUPRO_N,INFERENCE_BENCH_QUALITY_CONCURRENCY,INFERENCE_BENCH_QUALITY_BASELINE_REGISTRY,INFERENCE_BENCH_QUALITY_BASELINE_BACKEND,INFERENCE_BENCH_QUALITY_MMLUPRO_SAMPLES_FILE,HPO_BASELINE_OUT_ROOT,HPO_BASELINE_QUALITY_SEED,HPO_BASELINE_QUICK_EVAL_TIMEOUT_S,HPO_BASELINE_SERVER_START_TIMEOUT_S,HPO_BASELINE_FIRST_SERVER_START_TIMEOUT_S,HPO_BASELINE_SERVER_INITIAL_DELAY_S,HPO_BASELINE_FINAL_SERVER_START_TIMEOUT_S,HPO_BASELINE_FINAL_EVAL_TIMEOUT_S,HPO_BASELINE_GPU_CLEAN_THRESHOLD_MB,HPO_BASELINE_AUTO_INSTALL_DEPS,HPO_BASELINE_OVERWRITE,HPO_BASELINE_MAX_TRIALS,HPO_BASELINE_ALLOW_UNSAFE_SEARCH_SPACE
environment = "INFERENCE_BENCH_INNER_MODE=hpo_search HPO_BASELINE_METHOD=$(method) HPO_BASELINE_SCENARIO=$(scenario) HPO_BASELINE_SEED_ID=$(seed_id) HPO_BASELINE_SEED_DEV=$(seed_dev) HPO_BASELINE_SEED_EVAL=$(seed_eval) HPO_BASELINE_BUDGET_S=$(budget_s)"
error = hpo_search_$(method)_$(engine)_$(scenario)_$(Cluster).err
output = hpo_search_$(method)_$(engine)_$(scenario)_$(Cluster).out
log = hpo_search_$(method)_$(engine)_$(scenario)_$(Cluster).log
request_memory = 180000
request_cpus = 16
request_gpus = 1
request_disk = 400G
requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3"
+BypassLXCfs = "true"
stream_output = true
stream_error = true
queue
