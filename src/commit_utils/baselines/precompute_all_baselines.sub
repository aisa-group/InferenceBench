executable = /bin/bash
arguments = src/baselines/run_precompute_all_baselines.sh $(base_model) $(Cluster) $(backends) $(dataset_seed) $(quality_seed) $(mmlupro_n) $(quality_concurrency)
getenv = HOME,HF_HOME,HF_TOKEN,HF_HUB_DISABLE_XET,INFERENCE_BENCH_RESULTS_DIR,INFERENCE_BENCH_CONTAINERS_DIR,INFERENCE_BENCH_BASELINE_CONTAINER_VLLM_NAME,INFERENCE_BENCH_BASELINE_CONTAINER_SGLANG_NAME,INFERENCE_BENCH_BASELINE_CONTAINER_TORCH_NAME,INFERENCE_BENCH_BASELINE_CONTAINER_TGI_NAME,INFERENCE_BENCH_VENV_VLLM_HOST,INFERENCE_BENCH_VENV_SGLANG_HOST,INFERENCE_BENCH_VENV_TORCH_HOST,INFERENCE_BENCH_VENV_TGI_HOST,INFERENCE_BENCH_MAX_MODEL_LEN,INFERENCE_BENCH_INPUT_TOKEN_MARGIN,INFERENCE_BENCH_SERVER_START_TIMEOUT_S,INFERENCE_BENCH_SKIP_SPEED,INFERENCE_BENCH_SKIP_QUALITY,INFERENCE_BENCH_DOWNLOAD_ONLY,INFERENCE_BENCH_QUALITY_TAU,INFERENCE_BENCH_QUALITY_BASELINE_REGISTRY,INFERENCE_BENCH_QUALITY_BASELINE_BACKEND,INFERENCE_BENCH_QUALITY_MMLUPRO_SAMPLES_FILE
error = baseline_precompute_$(Cluster).err
output = baseline_precompute_$(Cluster).out
log = baseline_precompute_$(Cluster).log
request_memory = 180000
request_cpus = 16
request_gpus = 1
request_disk = 400G
requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3"
+BypassLXCfs = "true"
stream_output = true
stream_error = true
queue
