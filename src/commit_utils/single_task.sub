executable = /bin/bash
arguments = src/run_task.sh $(eval) $(agent) $(base_model) $(Cluster) $(num_hours) $(agent_config) $(starting_point) $(agent_seed) $(eval_seed)
getenv = HOME,HF_HOME,HF_TOKEN,OPENAI_API_KEY,ANTHROPIC_API_KEY,CLAUDE_CODE_OAUTH_TOKEN,GEMINI_API_KEY,INFERENCE_BENCH_RESULTS_DIR,INFERENCE_BENCH_CONTAINERS_DIR,INFERENCE_BENCH_CONTAINER_NAME,INFERENCE_BENCH_CONTAINER_NAME_VLLM_RUNNING,INFERENCE_BENCH_BASELINE_CONTAINER_VLLM_NAME,INFERENCE_BENCH_EXPERIMENT_NAME,INFERENCE_BENCH_PROMPT,INFERENCE_BENCH_BASE_MODEL,INFERENCE_BENCH_STARTING_POINT,INFERENCE_BENCH_MAX_MODEL_LEN,INFERENCE_BENCH_INPUT_TOKEN_MARGIN,INFERENCE_BENCH_QUALITY_TAU,INFERENCE_BENCH_QUALITY_SEED,INFERENCE_BENCH_QUALITY_MMLUPRO_N,INFERENCE_BENCH_QUALITY_CONCURRENCY,INFERENCE_BENCH_QUALITY_BASELINE_REGISTRY,INFERENCE_BENCH_QUALITY_BASELINE_BACKEND,INFERENCE_BENCH_QUALITY_MMLUPRO_SAMPLES_FILE,INFERENCE_BENCH_METRICS_PATH,INFERENCE_BENCH_SERVER_HOST,INFERENCE_BENCH_SERVER_PORT,INFERENCE_BENCH_SERVER_WAIT_S,INFERENCE_BENCH_ALLOW_HF_DOWNLOAD,INFERENCE_BENCH_TMP_ROOT,INFERENCE_BENCH_LOAD_CUDA_MODULE
should_transfer_files = NO
output = single_task_$(Cluster).out
error = single_task_$(Cluster).err
log = single_task_$(Cluster).log
request_memory = 180000
request_cpus = 16
request_gpus = 1
request_disk = 400G
requirements = (TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3")
+BypassLXCfs = "true"
on_exit_hold = (ExitCode == 85)
on_exit_hold_reason = "Job checkpointed for resume; will retry"
on_exit_hold_subcode = 99
periodic_release = ((HoldReasonCode == 34) && (NumSystemHolds < 3)) || ((HoldReasonCode == 3) && (HoldReasonSubCode == 99) && (NumSystemHolds < 5))
queue
